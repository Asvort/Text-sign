local function ttf_log(message, ...)
    local format_ok, text = pcall(function(msg, ...)
        return string.format(TAG .. tostring(msg), ...)
    end, message, ...)

    if not format_ok then
        text = TAG .. tostring(message)
    end

    local printf_ok, printf_function = pcall(function()
        return printf
    end)

    if printf_ok and type(printf_function) == "function" then
        pcall(printf_function, "%s", text)
        return
    end

    local log_ok, log_function = pcall(function()
        return log
    end)

    if log_ok and type(log_function) == "function" then
        pcall(log_function, text)
    end
end


local function is_duplicate_cdef_error(error_text)
    local lowered = string.lower(tostring(error_text or ""))
    return string.find(lowered, "redefin", 1, true) ~= nil
        or string.find(lowered, "already defined", 1, true) ~= nil
        or string.find(lowered, "previous declaration", 1, true) ~= nil
        or string.find(lowered, "duplicate", 1, true) ~= nil
end

local function get_io_table()
    local ok, io_table = pcall(function()
        return io
    end)

    if ok and io_table and type(io_table.open) == "function" then
        return io_table
    end

    return nil
end

local function read_binary_file(path)
    local io_table = get_io_table()
    if not io_table then return nil, "io.open is unavailable" end

    local open_ok, file_or_error = pcall(function()
        return io_table.open(path, "rb")
    end)

    if not open_ok or not file_or_error then
        return nil, tostring(file_or_error or "open failed")
    end

    local file = file_or_error
    local read_ok, data_or_error = pcall(function()
        return file:read("*a")
    end)

    pcall(function()
        file:close()
    end)

    if not read_ok or type(data_or_error) ~= "string" then
        return nil, tostring(data_or_error or "read failed")
    end

    return data_or_error
end

local function write_binary_file(path, data)
    local io_table = get_io_table()
    if not io_table then
        return false, "io.open is unavailable"
    end

    local open_ok, file_or_error = pcall(function()
        return io_table.open(path, "wb")
    end)

    if not open_ok or not file_or_error then
        return false, tostring(file_or_error or "open failed")
    end

    local file = file_or_error
    local write_ok, write_result, write_error = pcall(function()
        return file:write(data)
    end)
    local flush_ok, flush_result, flush_error = false, nil, nil
    if write_ok and write_result then
        flush_ok, flush_result, flush_error = pcall(function()
            return file:flush()
        end)
    end
    local close_ok, close_result, close_error = pcall(function()
        return file:close()
    end)

    if not write_ok or not write_result then
        return false, tostring(write_error or write_result or "write failed")
    end
    if not flush_ok or not flush_result then
        return false, tostring(flush_error or flush_result or "flush failed")
    end
    if not close_ok or not close_result then
        return false, tostring(close_error or close_result or "close failed")
    end

    return true
end

local function get_filesystem()
    local getter_ok, getter = pcall(function()
        return getFS
    end)

    if not getter_ok or type(getter) ~= "function" then
        return nil
    end

    local fs_ok, filesystem = pcall(getter)
    if fs_ok then
        return filesystem
    end

    return nil
end

local function resolve_game_data_path(relative_path)
    local filesystem = get_filesystem()
    if not filesystem then return nil end

    local method_ok, update_path = pcall(function()
        return filesystem.update_path
    end)

    if not method_ok or type(update_path) ~= "function" then
        return nil
    end

    local resolve_ok, resolved_path = pcall(function()
        return filesystem:update_path("$game_data$", relative_path)
    end)

    if resolve_ok and resolved_path and resolved_path ~= "" then
        return resolved_path
    end

    return nil
end

local function join_windows_path(directory, filename)
    if not directory or directory == "" then
        return filename
    end

    local last = string.sub(directory, -1)
    if last == "\\" or last == "/" then
        return directory .. filename
    end

    return directory .. "\\" .. filename
end

local function get_directory_name(path)
    if type(path) ~= "string" then
        return nil
    end

    return string.match(path, "^(.*)[\\/][^\\/]+$")
end

local function get_logical_game_bin_directory()
    local game_data_path = resolve_game_data_path("")
    if type(game_data_path) ~= "string" or game_data_path == "" then
        return nil
    end

    local normalized_path = string.gsub(game_data_path, "[\\/]+$", "")
    local game_root_path = string.gsub(normalized_path, "[\\/]gamedata$", "")
    if game_root_path == normalized_path then
        return nil
    end

    return join_windows_path(game_root_path, "bin")
end

local function declare_kernel32(local_ffi)
    local module_ok, module_error = pcall(function()
        local_ffi.cdef([[
            unsigned long __stdcall GetModuleFileNameA(void* hModule, char* lpFilename, unsigned long nSize);
        ]])
    end)

    if not module_ok and not is_duplicate_cdef_error(module_error) then
        ttf_log("GetModuleFileNameA ffi.cdef FAILED: %s", tostring(module_error))
        return false
    end

    return true
end

local function load_kernel32(local_ffi)
    local load_ok, library_or_error = pcall(function()
        return local_ffi.load("kernel32")
    end)
    if load_ok and library_or_error then return library_or_error end

    local fallback_ok, fallback_or_error = pcall(function()
        return local_ffi.load("kernel32.dll")
    end)
    if fallback_ok and fallback_or_error then return fallback_or_error end

    ttf_log("ffi.load('kernel32') FAILED: %s; fallback FAILED: %s", tostring(library_or_error), tostring(fallback_or_error))
    return nil
end

local function get_executable_path(local_ffi, kernel32)
    local buffer_size = 32768
    local buffer_ok, buffer_or_error = pcall(function()
        return local_ffi.new("char[?]", buffer_size)
    end)
    if not buffer_ok or not buffer_or_error then return nil end

    local call_ok, length_or_error = pcall(function()
        return kernel32.GetModuleFileNameA(nil, buffer_or_error, buffer_size)
    end)
    if not call_ok then return nil end

    local length = tonumber(length_or_error) or 0
    if length <= 0 then return nil end

    local string_ok, executable_path = pcall(function()
        return local_ffi.string(buffer_or_error, length)
    end)
    if not string_ok or not executable_path or executable_path == "" then return nil end

    return executable_path
end

local function declare_freetype(local_ffi)
    local cdef_ok, cdef_error = pcall(function()
        local_ffi.cdef([[
            typedef signed char        TC_FT_Char;
            typedef unsigned char      TC_FT_Byte;
            typedef signed short       TC_FT_Short;
            typedef unsigned short     TC_FT_UShort;
            typedef signed int         TC_FT_Int;
            typedef unsigned int       TC_FT_UInt;
            typedef signed long        TC_FT_Long;
            typedef unsigned long      TC_FT_ULong;
            typedef signed long        TC_FT_Fixed;
            typedef signed long        TC_FT_Pos;
            typedef signed int         TC_FT_Int32;
            typedef signed int         TC_FT_Error;
            typedef char               TC_FT_String;

            typedef struct TC_FT_LibraryRec_*   TC_FT_Library;
            typedef struct TC_FT_FaceRec_*      TC_FT_Face;
            typedef struct TC_FT_SizeRec_*      TC_FT_Size;
            typedef struct TC_FT_CharMapRec_*   TC_FT_CharMap;
            typedef struct TC_FT_GlyphSlotRec_* TC_FT_GlyphSlot;

            typedef void (*TC_FT_Generic_Finalizer)(void* object);

            typedef struct TC_FT_Generic_ {
                void* data;
                TC_FT_Generic_Finalizer finalizer;
            } TC_FT_Generic;

            typedef struct TC_FT_Vector_ {
                TC_FT_Pos x;
                TC_FT_Pos y;
            } TC_FT_Vector;

            typedef struct TC_FT_BBox_ {
                TC_FT_Pos xMin;
                TC_FT_Pos yMin;
                TC_FT_Pos xMax;
                TC_FT_Pos yMax;
            } TC_FT_BBox;

            typedef struct TC_FT_Glyph_Metrics_ {
                TC_FT_Pos width;
                TC_FT_Pos height;
                TC_FT_Pos horiBearingX;
                TC_FT_Pos horiBearingY;
                TC_FT_Pos horiAdvance;
                TC_FT_Pos vertBearingX;
                TC_FT_Pos vertBearingY;
                TC_FT_Pos vertAdvance;
            } TC_FT_Glyph_Metrics;

            typedef struct TC_FT_Bitmap_ {
                unsigned int rows;
                unsigned int width;
                int pitch;
                unsigned char* buffer;
                unsigned short num_grays;
                unsigned char pixel_mode;
                unsigned char palette_mode;
                void* palette;
            } TC_FT_Bitmap;

            typedef unsigned int TC_FT_Glyph_Format;

            typedef struct TC_FT_GlyphSlotRec_ {
                TC_FT_Library library;
                TC_FT_Face face;
                TC_FT_GlyphSlot next;
                TC_FT_UInt glyph_index;
                TC_FT_Generic generic;
                TC_FT_Glyph_Metrics metrics;
                TC_FT_Fixed linearHoriAdvance;
                TC_FT_Fixed linearVertAdvance;
                TC_FT_Vector advance;
                TC_FT_Glyph_Format format;
                TC_FT_Bitmap bitmap;
                TC_FT_Int bitmap_left;
                TC_FT_Int bitmap_top;
            } TC_FT_GlyphSlotRec;

            typedef struct TC_FT_Bitmap_Size_ {
                TC_FT_Short height;
                TC_FT_Short width;
                TC_FT_Pos size;
                TC_FT_Pos x_ppem;
                TC_FT_Pos y_ppem;
            } TC_FT_Bitmap_Size;

            typedef struct TC_FT_FaceRec_ {
                TC_FT_Long num_faces;
                TC_FT_Long face_index;
                TC_FT_Long face_flags;
                TC_FT_Long style_flags;
                TC_FT_Long num_glyphs;
                TC_FT_String* family_name;
                TC_FT_String* style_name;
                TC_FT_Int num_fixed_sizes;
                TC_FT_Bitmap_Size* available_sizes;
                TC_FT_Int num_charmaps;
                TC_FT_CharMap* charmaps;
                TC_FT_Generic generic;
                TC_FT_BBox bbox;
                TC_FT_UShort units_per_EM;
                TC_FT_Short ascender;
                TC_FT_Short descender;
                TC_FT_Short height;
                TC_FT_Short max_advance_width;
                TC_FT_Short max_advance_height;
                TC_FT_Short underline_position;
                TC_FT_Short underline_thickness;
                TC_FT_GlyphSlot glyph;
                TC_FT_Size size;
                TC_FT_CharMap charmap;
            } TC_FT_FaceRec;

            TC_FT_Error FT_Init_FreeType(TC_FT_Library* alibrary);
            TC_FT_Error FT_Done_FreeType(TC_FT_Library library);
            TC_FT_Error FT_New_Memory_Face(TC_FT_Library library, const TC_FT_Byte* file_base, TC_FT_Long file_size, TC_FT_Long face_index, TC_FT_Face* aface);
            TC_FT_Error FT_Done_Face(TC_FT_Face face);
            TC_FT_Error FT_Select_Charmap(TC_FT_Face face, unsigned int encoding);
            TC_FT_UInt FT_Get_Char_Index(TC_FT_Face face, TC_FT_ULong charcode);
            TC_FT_Error FT_Set_Pixel_Sizes(TC_FT_Face face, TC_FT_UInt pixel_width, TC_FT_UInt pixel_height);
            TC_FT_Error FT_Load_Char(TC_FT_Face face, TC_FT_ULong char_code, TC_FT_Int32 load_flags);
        ]])
    end)

    if cdef_ok or is_duplicate_cdef_error(cdef_error) then
        return true
    end

    ttf_log("FreeType ffi.cdef FAILED: %s", tostring(cdef_error))
    return false
end


local function load_sibling_library(local_ffi, executable_directory, filename)
    local full_path = join_windows_path(executable_directory, filename)
    local load_ok, library_or_error = pcall(function()
        return local_ffi.load(full_path)
    end)
    if load_ok and library_or_error then return library_or_error, full_path end

    local fallback_ok, fallback_or_error = pcall(function()
        return local_ffi.load(filename)
    end)
    if fallback_ok and fallback_or_error then return fallback_or_error, filename end

    return nil, tostring(library_or_error) .. " / " .. tostring(fallback_or_error)
end

local function get_resolved_default_ttf_path()
    if M._resolved_default_ttf_path then return M._resolved_default_ttf_path end
    local resolved = resolve_game_data_path(DEFAULT_TTF_PATH) or ("gamedata\\" .. DEFAULT_TTF_PATH)
    M._resolved_default_ttf_path = resolved
    return resolved
end

local function resolve_family_ttf_path(family, variant_index)
    if family then
        if family.variants and #family.variants > 0 then
            local index = math.floor((tonumber(variant_index) or 0) + 0.5) + 1
            if index < 1 then index = 1 end
            if index > #family.variants then index = #family.variants end
            local variant = family.variants[index]
            local relative_path = variant and variant.ttf_path
            if relative_path then
                return resolve_game_data_path(relative_path) or ("gamedata\\" .. relative_path)
            end
        end
    end

    return get_resolved_default_ttf_path()
end

local function u32le(value)
    local number = tonumber(value) or 0
    number = number % 4294967296

    local b1 = number % 256
    number = math.floor(number / 256)
    local b2 = number % 256
    number = math.floor(number / 256)
    local b3 = number % 256
    number = math.floor(number / 256)
    local b4 = number % 256

    return string.char(b1, b2, b3, b4)
end

local function read_u32le(data, offset)
    local b1, b2, b3, b4 = string.byte(data, offset + 1, offset + 4)
    if not b1 or not b2 or not b3 or not b4 then return nil end
    return b1 + b2 * 256 + b3 * 65536 + b4 * 16777216
end

local function build_bgra8_dds(local_ffi, width, height, pixels)
    local DDSD_CAPS = 0x00000001
    local DDSD_HEIGHT = 0x00000002
    local DDSD_WIDTH = 0x00000004
    local DDSD_PITCH = 0x00000008
    local DDSD_PIXELFORMAT = 0x00001000
    local DDPF_ALPHAPIXELS = 0x00000001
    local DDPF_RGB = 0x00000040
    local DDSCAPS_TEXTURE = 0x00001000

    local header = {
        "DDS ",
        u32le(124),
        u32le(DDSD_CAPS + DDSD_HEIGHT + DDSD_WIDTH + DDSD_PITCH + DDSD_PIXELFORMAT),
        u32le(height),
        u32le(width),
        u32le(width * 4),
        u32le(0),
        u32le(0),
        string.rep(u32le(0), 11),
        u32le(32),
        u32le(DDPF_ALPHAPIXELS + DDPF_RGB),
        u32le(0),
        u32le(32),
        u32le(0x00FF0000),
        u32le(0x0000FF00),
        u32le(0x000000FF),
        u32le(0xFF000000),
        u32le(DDSCAPS_TEXTURE),
        u32le(0),
        u32le(0),
        u32le(0),
        u32le(0),
    }

    local header_string = table.concat(header)
    local pixel_count = width * height * 4
    local pixel_string_ok, pixel_string_or_error = pcall(function()
        return local_ffi.string(pixels, pixel_count)
    end)

    if not pixel_string_ok then
        return nil, tostring(pixel_string_or_error)
    end

    local dds_data = header_string .. pixel_string_or_error
    return dds_data
end

local CP1251_TO_UNICODE = {
    [0x80] = 0x0402, [0x81] = 0x0403, [0x82] = 0x201A, [0x83] = 0x0453,
    [0x84] = 0x201E, [0x85] = 0x2026, [0x86] = 0x2020, [0x87] = 0x2021,
    [0x88] = 0x20AC, [0x89] = 0x2030, [0x8A] = 0x0409, [0x8B] = 0x2039,
    [0x8C] = 0x040A, [0x8D] = 0x040C, [0x8E] = 0x040B, [0x8F] = 0x040F,
    [0x90] = 0x0452, [0x91] = 0x2018, [0x92] = 0x2019, [0x93] = 0x201C,
    [0x94] = 0x201D, [0x95] = 0x2022, [0x96] = 0x2013, [0x97] = 0x2014,
    [0x98] = 0x003F, [0x99] = 0x2122, [0x9A] = 0x0459, [0x9B] = 0x203A,
    [0x9C] = 0x045A, [0x9D] = 0x045C, [0x9E] = 0x045B, [0x9F] = 0x045F,
    [0xA0] = 0x00A0, [0xA1] = 0x040E, [0xA2] = 0x045E, [0xA3] = 0x0408,
    [0xA4] = 0x00A4, [0xA5] = 0x0490, [0xA6] = 0x00A6, [0xA7] = 0x00A7,
    [0xA8] = 0x0401, [0xA9] = 0x00A9, [0xAA] = 0x0404, [0xAB] = 0x00AB,
    [0xAC] = 0x00AC, [0xAD] = 0x00AD, [0xAE] = 0x00AE, [0xAF] = 0x0407,
    [0xB0] = 0x00B0, [0xB1] = 0x00B1, [0xB2] = 0x0406, [0xB3] = 0x0456,
    [0xB4] = 0x0491, [0xB5] = 0x00B5, [0xB6] = 0x00B6, [0xB7] = 0x00B7,
    [0xB8] = 0x0451, [0xB9] = 0x2116, [0xBA] = 0x0454, [0xBB] = 0x00BB,
    [0xBC] = 0x0458, [0xBD] = 0x0405, [0xBE] = 0x0455, [0xBF] = 0x0457,
}

for byte = 0xC0, 0xFF do
    CP1251_TO_UNICODE[byte] = 0x0410 + (byte - 0xC0)
end


local function decode_utf8_strict(text)
    local result = {}
    local i = 1
    local length = #text

    while i <= length do
        local b1 = string.byte(text, i)
        if not b1 then return nil end

        local codepoint = nil
        local bytes = 1

        if b1 < 0x80 then
            codepoint = b1
        elseif b1 >= 0xC2 and b1 <= 0xDF then
            local b2 = string.byte(text, i + 1)
            if not (b2 and b2 >= 0x80 and b2 <= 0xBF) then return nil end
            codepoint = (b1 - 0xC0) * 0x40 + (b2 - 0x80)
            bytes = 2
        elseif b1 >= 0xE0 and b1 <= 0xEF then
            local b2 = string.byte(text, i + 1)
            local b3 = string.byte(text, i + 2)
            if not (b2 and b3 and b2 >= 0x80 and b2 <= 0xBF and b3 >= 0x80 and b3 <= 0xBF) then return nil end
            if b1 == 0xE0 and b2 < 0xA0 then return nil end
            if b1 == 0xED and b2 > 0x9F then return nil end
            codepoint = (b1 - 0xE0) * 0x1000 + (b2 - 0x80) * 0x40 + (b3 - 0x80)
            bytes = 3
        elseif b1 >= 0xF0 and b1 <= 0xF4 then
            local b2 = string.byte(text, i + 1)
            local b3 = string.byte(text, i + 2)
            local b4 = string.byte(text, i + 3)
            if not (b2 and b3 and b4 and b2 >= 0x80 and b2 <= 0xBF and b3 >= 0x80 and b3 <= 0xBF and b4 >= 0x80 and b4 <= 0xBF) then return nil end
            if b1 == 0xF0 and b2 < 0x90 then return nil end
            if b1 == 0xF4 and b2 > 0x8F then return nil end
            codepoint = (b1 - 0xF0) * 0x40000 + (b2 - 0x80) * 0x1000 + (b3 - 0x80) * 0x40 + (b4 - 0x80)
            bytes = 4
        else
            return nil
        end

        result[#result + 1] = codepoint
        i = i + bytes
    end

    return result
end

local function decode_cp1251(text)
    local result = {}
    for index = 1, #text do
        local byte = string.byte(text, index)
        if byte < 0x80 then
            result[#result + 1] = byte
        else
            result[#result + 1] = CP1251_TO_UNICODE[byte] or 0x003F
        end
    end
    return result
end

local function text_to_codepoints(text)
    if type(text) ~= "string" then return {} end

    local utf8 = decode_utf8_strict(text)
    if utf8 then
        return utf8, "utf8"
    end

    return decode_cp1251(text), "cp1251"
end

local function get_bitmap_alpha(bitmap, x, y)
    local width = tonumber(bitmap.width) or 0
    local rows = tonumber(bitmap.rows) or 0
    local pitch = tonumber(bitmap.pitch) or 0
    local pixel_mode = tonumber(bitmap.pixel_mode) or 0

    if x < 0 or x >= width or y < 0 or y >= rows or pitch == 0 then return 0 end

    local row_pointer = bitmap.buffer + y * pitch

    if pixel_mode == 2 then
        local value = tonumber(row_pointer[x]) or 0
        local levels = tonumber(bitmap.num_grays) or 256
        if levels > 1 and levels ~= 256 then
            value = math.floor((value * 255) / (levels - 1) + 0.5)
        end
        return math.max(0, math.min(255, value))
    end

    if pixel_mode == 1 then
        local byte_value = tonumber(row_pointer[math.floor(x / 8)]) or 0
        local divisor = 2 ^ (7 - (x % 8))
        return (math.floor(byte_value / divisor) % 2 == 1) and 255 or 0
    end

    if pixel_mode == 3 then
        local byte_value = tonumber(row_pointer[math.floor(x / 4)]) or 0
        local divisor = 2 ^ (6 - 2 * (x % 4))
        return (math.floor(byte_value / divisor) % 4) * 85
    end

    if pixel_mode == 4 then
        local byte_value = tonumber(row_pointer[math.floor(x / 2)]) or 0
        local divisor = 2 ^ (4 - 4 * (x % 2))
        return (math.floor(byte_value / divisor) % 16) * 17
    end

    if pixel_mode == 7 then
        return tonumber(row_pointer[x * 4 + 3]) or 0
    end

    return 0
end

local function load_glyph_metrics(freetype, face, codepoint, glyph_cache)
    if glyph_cache.glyphs[codepoint] then return glyph_cache.glyphs[codepoint] end
    local FT_LOAD_RENDER = 4
    local load_ok, load_result = pcall(function()
        return freetype.FT_Load_Char(face, codepoint, FT_LOAD_RENDER)
    end)
    if not load_ok then return nil, tostring(load_result) end

    local load_error = tonumber(load_result) or -1
    if load_error ~= 0 then return nil, load_error end

    local slot = face.glyph
    if slot == nil then return nil, "glyph slot is nil" end

    local bitmap = slot.bitmap
    local metrics = {
        codepoint = codepoint,
        width = tonumber(bitmap.width) or 0,
        rows = tonumber(bitmap.rows) or 0,
        left = tonumber(slot.bitmap_left) or 0,
        top = tonumber(slot.bitmap_top) or 0,
        advance_x = (tonumber(slot.advance.x) or 0) / 64,
    }
    local bitmap_size = metrics.width * metrics.rows
    if bitmap_size <= glyph_cache.remaining then
        if bitmap_size > 0 then
            metrics.alpha = M._ffi.new("unsigned char[?]", bitmap_size)
            for y = 0, metrics.rows - 1 do
                for x = 0, metrics.width - 1 do
                    metrics.alpha[y * metrics.width + x] = get_bitmap_alpha(bitmap, x, y)
                end
            end
        end
        metrics.bitmap_cached = true
        glyph_cache.remaining = glyph_cache.remaining - bitmap_size
    end
    glyph_cache.glyphs[codepoint] = metrics
    return metrics
end

local function get_uniform_glyph_gap(pixel_size)
    return math.max(1, math.floor((tonumber(pixel_size) or 1) * 0.08 + 0.5))
end

local function build_layout(freetype, face, codepoints, glyph_gap, glyph_cache)
    local glyphs = {}
    local cursor_x = 0
    local min_x = nil
    local max_x = nil
    local min_y = nil
    local max_y = nil
    glyph_gap = math.max(0, tonumber(glyph_gap) or 0)

    for index = 1, #codepoints do
        local metrics, metrics_error = load_glyph_metrics(freetype, face, codepoints[index], glyph_cache)
        if not metrics then return nil, metrics_error end

        local logical_width = math.max(1, math.floor(metrics.advance_x + 0.5))
        local draw_x = cursor_x + metrics.left

        glyphs[#glyphs + 1] = {
            codepoint = metrics.codepoint,
            draw_x = draw_x,
            left = metrics.left,
            top = metrics.top,
            width = metrics.width,
            rows = metrics.rows,
            logical_width = logical_width,
            metrics = metrics,
        }

        if metrics.width > 0 and metrics.rows > 0 then
            local glyph_min_x = draw_x
            local glyph_max_x = draw_x + metrics.width
            local glyph_min_y = -metrics.top
            local glyph_max_y = glyph_min_y + metrics.rows
            if min_x == nil or glyph_min_x < min_x then min_x = glyph_min_x end
            if max_x == nil or glyph_max_x > max_x then max_x = glyph_max_x end
            if min_y == nil or glyph_min_y < min_y then min_y = glyph_min_y end
            if max_y == nil or glyph_max_y > max_y then max_y = glyph_max_y end
        end

        cursor_x = cursor_x + logical_width
        if index < #codepoints then
            cursor_x = cursor_x + glyph_gap
        end
    end

    if min_y == nil then
        min_x = 0
        max_x = 1
        min_y = 0
        max_y = 1
    end

    min_x = min_x or 0
    max_x = max_x or math.max(1, cursor_x)

    return {
        glyphs = glyphs,
        min_x = min_x,
        min_y = min_y,
        max_x = max_x,
        max_y = max_y,
        content_width = math.max(1, math.ceil(max_x - min_x)),
        content_height = math.max(1, math.ceil(max_y - min_y)),
        gap = glyph_gap,
    }
end

local function get_font_bytes(path)
    local cached = M.font_file_cache[path]
    if cached then return cached.data, cached.size end

    local data, error_text = read_binary_file(path)
    if not data then return nil, error_text end

    cached = { data = data, size = #data }
    M.font_file_cache[path] = cached
    return cached.data, cached.size
end


local function get_slot_texture_name(slot_key, variant_index)
    local slot = SLOT_DEFS[slot_key]
    if not slot then return nil end
    local index = math.max(0, math.min(SLOT_VARIANT_COUNT - 1, tonumber(variant_index) or 0))
    return slot.texture_prefix .. string.format("%d", index)
end

local function get_slot_file_path(slot_key, variant_index)
    local slot = SLOT_DEFS[slot_key]
    if not slot then return nil end
    local index = math.max(0, math.min(SLOT_VARIANT_COUNT - 1, tonumber(variant_index) or 0))
    local relative_path = slot.file_prefix .. string.format("%d.dds", index)
    return resolve_game_data_path(relative_path) or ("gamedata\\" .. relative_path)
end

function M.is_ready()
    if M._init_attempted then return M._available end
    M._init_attempted = true

    local ok_load, local_ffi = pcall(function()
        return require("ffi")
    end)
    if not ok_load or not local_ffi then
        ttf_log("FFI unavailable: %s", tostring(local_ffi))
        M._available = false
        return false
    end

    if not declare_kernel32(local_ffi) then
        M._available = false
        return false
    end

    local kernel32 = load_kernel32(local_ffi)
    if not kernel32 then
        M._available = false
        return false
    end

    if not declare_freetype(local_ffi) then
        M._available = false
        return false
    end

    local logical_game_bin_directory = get_logical_game_bin_directory()
    local freetype_or_error = nil
    local dll_full_path = nil

    if logical_game_bin_directory then
        freetype_or_error, dll_full_path = load_sibling_library(local_ffi, logical_game_bin_directory, FREETYPE_DLL_NAME)
        if freetype_or_error then
            ttf_log("FreeType loaded through logical game bin: %s", tostring(dll_full_path))
        end
    end

    if not freetype_or_error then
        local executable_path = get_executable_path(local_ffi, kernel32)
        local executable_directory = get_directory_name(executable_path) or ""
        local fallback_library, fallback_path = load_sibling_library(local_ffi, executable_directory, FREETYPE_DLL_NAME)
        if fallback_library then
            freetype_or_error = fallback_library
            dll_full_path = fallback_path
            ttf_log("FreeType loaded through executable source bin: %s", tostring(dll_full_path))
        else
            ttf_log("FreeType DLL load failed: logical_bin=%s error=%s; executable_bin=%s error=%s", tostring(logical_game_bin_directory), tostring(dll_full_path), tostring(executable_directory), tostring(fallback_path))
            M._available = false
            return false
        end
    end

    local library_array = local_ffi.new("TC_FT_Library[1]")
    if library_array == nil then
        ttf_log("FT_Init_FreeType failed: library allocation returned nil")
        M._available = false
        return false
    end

    local init_ok, init_result = pcall(function()
        return freetype_or_error.FT_Init_FreeType(library_array)
    end)

    if not init_ok or tonumber(init_result) ~= 0 or library_array[0] == nil then
        ttf_log("FT_Init_FreeType failed: %s", tostring(init_result))
        M._available = false
        return false
    end

    M._ffi = local_ffi
    M._kernel32 = kernel32
	M._freetype = freetype_or_error
	M._library = library_array[0]
	M._available = true


	return true
end


function M.register_slot(slot_key, file_prefix, texture_prefix)
    slot_key = tostring(slot_key or "")
    file_prefix = tostring(file_prefix or "")
    texture_prefix = tostring(texture_prefix or "")
    if slot_key == "" or file_prefix == "" or texture_prefix == "" then return false end

    SLOT_DEFS[slot_key] = {
        file_prefix = file_prefix,
        texture_prefix = texture_prefix,
    }
    return true
end

local function sortable_name(value)
    if type(value) == "table" then
        local named = rawget(value, "name")
        if named ~= nil then return tostring(named) end
    end
    return tostring(value or "")
end

local function case_insensitive_sort(a, b)
    local name_a = sortable_name(a)
    local name_b = sortable_name(b)
    local lower_a = string.lower(name_a)
    local lower_b = string.lower(name_b)
    if lower_a == lower_b then
        return name_a < name_b
    end
    return lower_a < lower_b
end

local function display_family_name(folder_name)
    return string.gsub(tostring(folder_name or ""), "&amp;", "&")
end

local function names_equal(left, right)
    return string.lower(tostring(left or "")) == string.lower(tostring(right or ""))
end

local function list_game_data_entries(path, list_flag)
    local filesystem = get_filesystem()
    if not filesystem or not FS or not bit_or then
        return {}
    end

    local list_ok, file_list = pcall(function()
        return filesystem:file_list_open("$game_data$", path, bit_or(list_flag, FS.FS_RootOnly))
    end)
    if not list_ok or not file_list then return {} end

    local count_ok, count = pcall(function() return file_list:Size() end)
    if not count_ok then return {} end
    local entries = {}
    for index = 0, (tonumber(count) or 0) - 1 do
        local entry_ok, name = pcall(function() return file_list:GetAt(index) end)
        if entry_ok and name and name ~= "" then entries[#entries + 1] = tostring(name) end
    end
    return entries
end

local function is_font_filename(name)
    local lower = string.lower(tostring(name or ""))
    return string.sub(lower, -4) == ".ttf" or string.sub(lower, -4) == ".otf"
end


function M.get_font_catalog(force_refresh)
    if M._font_catalog and not force_refresh then
        return M._font_catalog
    end
    if not M.is_ready() then
        return {}
    end

    local catalog = {}
    local families_by_name = {}
    local variant_names_by_family = {}
    local folders = list_game_data_entries("fonts\\", FS.FS_ListFolders)

    for _, folder_entry in ipairs(folders) do
        local folder_name = string.gsub(folder_entry, "[\\/]+$", "")
        local family_name = display_family_name(folder_name)
        local family = families_by_name[family_name]
        if not family then
            family = { name = family_name, variants = {} }
            families_by_name[family_name] = family
            variant_names_by_family[family_name] = {}
            catalog[#catalog + 1] = family
        end
        local variant_names = variant_names_by_family[family_name]
        local files = list_game_data_entries("fonts\\" .. folder_name .. "\\", FS.FS_ListFiles)
        for _, file_entry in ipairs(files) do
            local file_name = string.match(file_entry, "[^\\/]+$") or file_entry
            local variant_key = string.lower(file_name)
            if is_font_filename(file_name) and not variant_names[variant_key] then
                variant_names[variant_key] = true
                family.variants[#family.variants + 1] = {
                    name = names_equal(file_name, "minecraft.ttf") and "Minecraft.ttf" or file_name,
                    ttf_path = "fonts\\" .. folder_name .. "\\" .. file_name,
                }
            end
        end
    end

    for index = #catalog, 1, -1 do
        local family = catalog[index]
        if #family.variants == 0 then
            table.remove(catalog, index)
        else
            table.sort(family.variants, case_insensitive_sort)
        end
    end
    table.sort(catalog, case_insensitive_sort)
    if #catalog == 0 then
        local default_path = get_resolved_default_ttf_path()
        local default_data = read_binary_file(default_path)
        if default_data then
            catalog[1] = {
                name = "Minecraft Rus",
                variants = {
                    { name = "Minecraft.ttf", ttf_path = DEFAULT_TTF_PATH },
                },
            }
            ttf_log("Font catalog fallback activated: %s", tostring(default_path))
        end
	end
	M._font_catalog = catalog
	return catalog
end

function M.find_font(family_name, variant_name)
    local catalog = M.get_font_catalog(false)
    local family = nil
    for _, candidate in ipairs(catalog) do
        if names_equal(candidate.name, family_name) then
            family = candidate
            break
        end
    end
    if not family then
        for _, candidate in ipairs(catalog) do
            if names_equal(candidate.name, "Minecraft Rus") then
                family = candidate
                break
            end
        end
    end
    family = family or catalog[1]
    if not family then
        return nil, nil, 0
    end

    local variant_index = 0
    local variant = family.variants and family.variants[1] or nil
    for index, candidate in ipairs(family.variants or {}) do
        if names_equal(candidate.name, variant_name) then
            variant = candidate
            variant_index = index - 1
            break
        end
    end
    return family, variant, variant_index
end

local function get_slot_state(slot_key)
    local state = M.slot_state[slot_key]
    if state then return state end

    state = {
        next_variant = -1,
        active = nil,
        pending = nil,
        request_signature = nil,
        request_since = 0,
    }
    M.slot_state[slot_key] = state
    return state
end

local function next_variant(state)
    if type(state) ~= "table" then return 0 end
    local active = rawget(state, "active")
    local active_variant = type(active) == "table" and tonumber(rawget(active, "variant")) or nil
    local previous = tonumber(rawget(state, "next_variant")) or -1
    for offset = 1, SLOT_VARIANT_COUNT do
        local value = (previous + offset) % SLOT_VARIANT_COUNT
        if value ~= active_variant then
            rawset(state, "next_variant", value)
            return value
        end
    end
    return 0
end

local function empty_slot_dds()
    if not M.is_ready() then return nil end
    if empty_slot_dds_cache then return empty_slot_dds_cache end
    local ffi = M._ffi
    if not ffi then return nil end
    local pixel = ffi.new("unsigned char[4]")
    local dds_data, dds_error = build_bgra8_dds(ffi, 1, 1, pixel)
    if not dds_data then
        ttf_log("DDS clear failed: error=%s", tostring(dds_error))
        return nil
    end
    empty_slot_dds_cache = dds_data
    return empty_slot_dds_cache
end

local function clear_slot_variant(slot_key, variant, dds_data)
    local output_path = get_slot_file_path(slot_key, variant)
    local write_ok, write_error = write_binary_file(output_path, dds_data)
    if not write_ok then
        ttf_log("DDS clear failed: slot=%s path=%s error=%s", slot_key, tostring(output_path), tostring(write_error))
        return false
    end
    return true
end

function M.clear_slot(slot_key)
    slot_key = tostring(slot_key or "")
    if not SLOT_DEFS[slot_key] then return false end
    local dds_data = empty_slot_dds()
    if not dds_data then return false end
    local cleared = true
    for variant = 0, SLOT_VARIANT_COUNT - 1 do
        if not clear_slot_variant(slot_key, variant, dds_data) then cleared = false end
    end
    M.slot_state[slot_key] = nil
    return cleared
end

function M.compact_slot(slot_key)
    slot_key = tostring(slot_key or "")
    local state = M.slot_state[slot_key]
    local active = type(state) == "table" and rawget(state, "active") or nil
    local pending = type(state) == "table" and rawget(state, "pending") or nil
    if not SLOT_DEFS[slot_key] or type(active) ~= "table" then return false end
    if type(pending) == "table" then return false end
    local active_variant = tonumber(rawget(active, "variant"))
    if active_variant == nil then return false end
    local dds_data = empty_slot_dds()
    if not dds_data then return false end
    for variant = 0, SLOT_VARIANT_COUNT - 1 do
        if variant ~= active_variant and not clear_slot_variant(slot_key, variant, dds_data) then return false end
    end
    return true
end

function M.reset_slots()
    if not M.is_ready() then return false end
    local reset = true
    for slot_key in pairs(SLOT_DEFS) do
        if not M.clear_slot(slot_key) then reset = false end
    end
    return reset
end



local function current_time_ms()
    return time_global and time_global() or 0
end

local function entry_signature(entry)
    if type(entry) ~= "table" then return nil end
    return rawget(entry, "signature")
end

local function active_result(state)
    local active = type(state) == "table" and rawget(state, "active") or nil
    if type(active) ~= "table" then return false, nil end
    return true, rawget(active, "texture_name")
end

local function discard_stale_pending(state, desired_signature)
    if type(state) ~= "table" then return end
    local pending = rawget(state, "pending")
    if type(pending) == "table" and entry_signature(pending) ~= desired_signature then
        state.pending = nil
    end
end

local function open_face(font_path)
    local font_data, font_error = get_font_bytes(font_path)
    if not font_data then return nil, font_error end

    local ffi = M._ffi
    local freetype = M._freetype
    local library = M._library
    if not ffi or not freetype or library == nil then
        return nil, "FreeType runtime is not initialized"
    end

    local font_buffer = ffi.new("TC_FT_Byte[?]", #font_data)
    if font_buffer == nil then return nil, "font buffer allocation returned nil" end
    ffi.copy(font_buffer, font_data, #font_data)

    local face_array = ffi.new("TC_FT_Face[1]")
    if face_array == nil then return nil, "face array allocation returned nil" end
    local result = freetype.FT_New_Memory_Face(library, font_buffer, #font_data, 0, face_array)
    if tonumber(result) ~= 0 or face_array[0] == nil then
        return nil, "FT_New_Memory_Face=" .. tostring(result)
    end

    local face = face_array[0]
    pcall(function()
        freetype.FT_Select_Charmap(face, 0x756E6963)
    end)

    return {
        face = face,
        buffer = font_buffer,
    }, nil
end

local function close_face(context)
    if type(context) ~= "table" then return end
    local face = rawget(context, "face")
    local freetype = M._freetype
    if face ~= nil and freetype then
        pcall(function() freetype.FT_Done_Face(face) end)
    end
    context.face = nil
    context.buffer = nil
end

local function count_mask_components(mask, width, height, foreground)
    local visited = {}
    local components = 0
    for start = 0, width * height - 1 do
        local filled = mask[start] == true
        if filled == foreground and not visited[start] then
            local queue = { start }
            local queue_index = 1
            local touches_edge = false
            visited[start] = true
            while queue_index <= #queue do
                local index = queue[queue_index]
                queue_index = queue_index + 1
                local x = index % width
                local y = math.floor(index / width)
                if x == 0 or x == width - 1 or y == 0 or y == height - 1 then touches_edge = true end
                local left = index - 1
                if x > 0 and not visited[left] and (mask[left] == true) == foreground then
                    visited[left] = true
                    queue[#queue + 1] = left
                end
                local right = index + 1
                if x < width - 1 and not visited[right] and (mask[right] == true) == foreground then
                    visited[right] = true
                    queue[#queue + 1] = right
                end
                local above = index - width
                if y > 0 and not visited[above] and (mask[above] == true) == foreground then
                    visited[above] = true
                    queue[#queue + 1] = above
                end
                local below = index + width
                if y < height - 1 and not visited[below] and (mask[below] == true) == foreground then
                    visited[below] = true
                    queue[#queue + 1] = below
                end
            end
            if foreground or not touches_edge then components = components + 1 end
        end
    end
    return components
end

local function inspect_glyph_bitmap(freetype, face, codepoint)
    local FT_LOAD_RENDER = 4
    local load_result = freetype.FT_Load_Char(face, codepoint, FT_LOAD_RENDER)
    if tonumber(load_result) ~= 0 or face.glyph == nil then return nil end
    local bitmap = face.glyph.bitmap
    local width = tonumber(bitmap.width) or 0
    local height = tonumber(bitmap.rows) or 0
    local minimum_x, minimum_y, maximum_x, maximum_y = nil, nil, nil, nil
    for y = 0, height - 1 do
        for x = 0, width - 1 do
            if get_bitmap_alpha(bitmap, x, y) >= FONT_DETAIL_ALPHA_THRESHOLD then
                minimum_x = minimum_x and math.min(minimum_x, x) or x
                minimum_y = minimum_y and math.min(minimum_y, y) or y
                maximum_x = maximum_x and math.max(maximum_x, x) or x
                maximum_y = maximum_y and math.max(maximum_y, y) or y
            end
        end
    end
    if minimum_x == nil then return nil end

    local cropped_width = maximum_x - minimum_x + 1
    local cropped_height = maximum_y - minimum_y + 1
    local mask = {}
    local signature = { tostring(cropped_width), "x", tostring(cropped_height), ":" }
    for y = 0, cropped_height - 1 do
        for x = 0, cropped_width - 1 do
            local filled = get_bitmap_alpha(bitmap, minimum_x + x, minimum_y + y) >= FONT_DETAIL_ALPHA_THRESHOLD
            local index = y * cropped_width + x
            mask[index] = filled
            signature[#signature + 1] = filled and "1" or "0"
        end
    end

    local visited = {}
    local filter_stable = true
    for start = 0, cropped_width * cropped_height - 1 do
        if mask[start] and not visited[start] then
            local queue = { start }
            local queue_index = 1
            local component_stable = false
            visited[start] = true
            while queue_index <= #queue do
                local index = queue[queue_index]
                queue_index = queue_index + 1
                local x = index % cropped_width
                local y = math.floor(index / cropped_width)
                if x < cropped_width - 1 and y < cropped_height - 1
                    and mask[index + 1] and mask[index + cropped_width] and mask[index + cropped_width + 1] then
                    component_stable = true
                end

                local left = index - 1
                if x > 0 and mask[left] and not visited[left] then
                    visited[left] = true
                    queue[#queue + 1] = left
                end
                local right = index + 1
                if x < cropped_width - 1 and mask[right] and not visited[right] then
                    visited[right] = true
                    queue[#queue + 1] = right
                end
                local above = index - cropped_width
                if y > 0 and mask[above] and not visited[above] then
                    visited[above] = true
                    queue[#queue + 1] = above
                end
                local below = index + cropped_width
                if y < cropped_height - 1 and mask[below] and not visited[below] then
                    visited[below] = true
                    queue[#queue + 1] = below
                end
            end
            if not component_stable then
                filter_stable = false
                break
            end
        end
    end
    return {
        signature = table.concat(signature),
        components = count_mask_components(mask, cropped_width, cropped_height, true),
        holes = count_mask_components(mask, cropped_width, cropped_height, false),
        filter_stable = filter_stable,
    }
end

local function supported_probe_codepoints(freetype, face)
    local result = {}
    for _, codepoint in ipairs(FONT_DETAIL_PROBE_CODEPOINTS) do
        if tonumber(freetype.FT_Get_Char_Index(face, codepoint)) ~= 0 then result[#result + 1] = codepoint end
    end
    return result
end

local function measure_font_minimum_ppem(face)
    local freetype = M._freetype
    if not freetype or face == nil then return FONT_DETAIL_REFERENCE_PPEM end
    local codepoints = supported_probe_codepoints(freetype, face)
    if #codepoints == 0 then return FONT_DETAIL_REFERENCE_PPEM end
    if tonumber(freetype.FT_Set_Pixel_Sizes(face, 0, FONT_DETAIL_REFERENCE_PPEM)) ~= 0 then
        return FONT_DETAIL_REFERENCE_PPEM
    end

    local reference = {}
    local reference_signatures = {}
    for _, codepoint in ipairs(codepoints) do
        local details = inspect_glyph_bitmap(freetype, face, codepoint)
        if details and details.filter_stable and not reference_signatures[details.signature] then
            reference_signatures[details.signature] = true
            reference[#reference + 1] = {
                codepoint = codepoint,
                components = details.components,
                holes = details.holes,
            }
        end
    end
    if #reference == 0 then return FONT_DETAIL_REFERENCE_PPEM end

    for pixel_size = 1, FONT_DETAIL_REFERENCE_PPEM do
        if tonumber(freetype.FT_Set_Pixel_Sizes(face, 0, pixel_size)) == 0 then
            local signatures = {}
            local valid = true
            for _, expected in ipairs(reference) do
                local details = inspect_glyph_bitmap(freetype, face, expected.codepoint)
                if not details or not details.filter_stable
                    or details.components ~= expected.components or details.holes ~= expected.holes
                    or signatures[details.signature] then
                    valid = false
                    break
                end
                signatures[details.signature] = true
            end
            if valid then return pixel_size end
        end
    end
    return FONT_DETAIL_REFERENCE_PPEM
end

local function get_font_minimum_buffer_size(face, font_path)
    local cached = M.font_minimum_size_cache[font_path]
    if type(cached) == "table" and tonumber(cached.buffer_size) then return cached.buffer_size end
    local minimum_ppem = measure_font_minimum_ppem(face)
    local buffer_size = math.max(1, math.ceil(minimum_ppem * TEXT_DETAIL_REFERENCE_HEIGHT / SIGN_RENDER_PIXEL_SIZE))
	M.font_minimum_size_cache[font_path] = {
		minimum_ppem = minimum_ppem,
		buffer_size = buffer_size,
	}
	return buffer_size
end

local function normalize_sign_channel(value)
    return math.max(0, math.min(255, math.floor((tonumber(value) or 0) + 0.5)))
end

local function normalize_sign_alpha(value)
    return math.max(0, math.min(100, math.floor((tonumber(value) or 100) + 0.5)))
end

local function normalize_canvas_dimension(value)
    local dimension = math.max(SIGN_MIN_SIZE, math.min(SIGN_MAX_SIZE, tonumber(value) or SIGN_DEFAULT_SIZE))
    return math.floor(dimension * 2 + 0.5) / 2
end

local function calculate_canvas_dimensions(sign_width, sign_height, minimum_size)
    local base_width = math.max(1, math.floor(sign_width * SIGN_CANVAS_PIXEL_SCALE + 0.5))
    local base_height = math.max(1, math.floor(sign_height * SIGN_CANVAS_PIXEL_SCALE + 0.5))
    local shorter_side = math.max(1, math.min(base_width, base_height))
    local detail_scale = math.max(1, minimum_size / shorter_side)
    return math.max(1, math.ceil(base_width * detail_scale)),
        math.max(1, math.ceil(base_height * detail_scale))
end

local function parse_sign_base_dds(base_data)
    if type(base_data) ~= "string" or #base_data < 128 or string.sub(base_data, 1, 4) ~= "DDS " then
        return nil, "invalid sign base texture"
    end

    local height = read_u32le(base_data, 12) or 0
    local width = read_u32le(base_data, 16) or 0
    local pitch = read_u32le(base_data, 20) or 0
    local fourcc = read_u32le(base_data, 84) or 0
    local rgb_bits = read_u32le(base_data, 88) or 0
    local red_mask = read_u32le(base_data, 92) or 0
    local green_mask = read_u32le(base_data, 96) or 0
    local blue_mask = read_u32le(base_data, 100) or 0
    local alpha_mask = read_u32le(base_data, 104) or 0

    if width <= 0 or height <= 0 then
        return nil, "invalid sign base texture dimensions"
    end
    if fourcc ~= 0 then
        return nil, "unsupported compressed sign base texture"
    end
    if rgb_bits ~= 24 and rgb_bits ~= 32 then
        return nil, "unsupported sign base texture depth"
    end
    if red_mask ~= 0x00FF0000 or green_mask ~= 0x0000FF00 or blue_mask ~= 0x000000FF then
        return nil, "unsupported sign base texture channel masks"
    end
    if rgb_bits == 32 and alpha_mask ~= 0 and alpha_mask ~= 0xFF000000 then
        return nil, "unsupported sign base texture alpha mask"
    end

    local bytes_per_pixel = math.floor(rgb_bits / 8)
    if pitch < width * bytes_per_pixel then pitch = width * bytes_per_pixel end
    if #base_data < 128 + pitch * height then
        return nil, "invalid sign base texture data size"
    end

    return {
        width = width,
        height = height,
        pitch = pitch,
        bytes_per_pixel = bytes_per_pixel,
        has_alpha = rgb_bits == 32 and alpha_mask == 0xFF000000,
    }
end

local function allocate_sign_canvas(base_data, canvas_width, canvas_height)
    local ffi = M._ffi
    local canvas_size = canvas_width * canvas_height * 4
    if not ffi then return nil, "FFI runtime is not initialized" end

    local source, source_error = parse_sign_base_dds(base_data)
    if not source then return nil, source_error end

    local canvas = ffi.new("unsigned char[?]", canvas_size)
    if canvas == nil then return nil, "sign canvas allocation failed" end

    for y = 0, canvas_height - 1 do
        local source_y = y % source.height
        local source_row_offset = 129 + source_y * source.pitch
        local target_row = canvas + y * canvas_width * 4
        for x = 0, canvas_width - 1 do
            local source_x = x % source.width
            local source_offset = source_row_offset + source_x * source.bytes_per_pixel
            local target_offset = x * 4
            target_row[target_offset + 0] = string.byte(base_data, source_offset + 0) or 0
            target_row[target_offset + 1] = string.byte(base_data, source_offset + 1) or 0
            target_row[target_offset + 2] = string.byte(base_data, source_offset + 2) or 0
            target_row[target_offset + 3] = source.has_alpha and (string.byte(base_data, source_offset + 3) or 255) or 255
        end
    end
    return canvas
end

local function allocate_transparent_canvas(canvas_width, canvas_height)
    local ffi = M._ffi
    if not ffi then return nil, "FFI runtime is not initialized" end
    local canvas_size = canvas_width * canvas_height * 4
    local canvas = ffi.new("unsigned char[?]", canvas_size)
    if canvas == nil then return nil, "sign canvas allocation failed" end
    ffi.fill(canvas, canvas_size, 0)
    return canvas
end

local function allocate_solid_canvas(canvas_width, canvas_height, color)
    local ffi = M._ffi
    if not ffi then return nil, "FFI runtime is not initialized" end
    local canvas_size = canvas_width * canvas_height * 4
    local row_size = canvas_width * 4
    local canvas = ffi.new("unsigned char[?]", canvas_size)
    local row = ffi.new("unsigned char[?]", row_size)
    if canvas == nil or row == nil then return nil, "sign canvas allocation failed" end
    local red = normalize_sign_channel(rawget(color, "red"))
    local green = normalize_sign_channel(rawget(color, "green"))
    local blue = normalize_sign_channel(rawget(color, "blue"))
    for x = 0, canvas_width - 1 do
        local offset = x * 4
        row[offset + 0] = blue
        row[offset + 1] = green
        row[offset + 2] = red
        row[offset + 3] = 255
    end
    for y = 0, canvas_height - 1 do
        ffi.copy(canvas + y * row_size, row, row_size)
    end
    return canvas
end

local function build_sign_lines(freetype, face, codepoints, pixel_size, inner_width, inner_height, glyph_cache)
    local glyph_gap = get_uniform_glyph_gap(pixel_size)
    local line_step = math.max(1, math.floor(pixel_size * 1.25 + 0.5))
    local maximum_lines = math.max(1, math.floor(inner_height / line_step))
    local lines = {}
    local current = {}
    local current_width = 0
    local previous_was_cr = false

    local function finish_line(force)
        if not force and #current == 0 then return end
        local layout, layout_error = build_layout(freetype, face, current, glyph_gap, glyph_cache)
        if not layout then return nil, layout_error end
        lines[#lines + 1] = layout
        current = {}
        current_width = 0
        return true
    end

    for _, codepoint in ipairs(codepoints) do
        local is_newline = codepoint == 10 or codepoint == 13
        if is_newline then
            if not (codepoint == 10 and previous_was_cr) then
                local line_ok, line_error = finish_line(true)
                if not line_ok then return nil, line_error end
                if #lines >= maximum_lines then break end
            end
            previous_was_cr = codepoint == 13
        else
            previous_was_cr = false
            local metrics, metrics_error = load_glyph_metrics(freetype, face, codepoint, glyph_cache)
            if not metrics then return nil, metrics_error end
            local advance = math.max(1, math.floor((tonumber(metrics.advance_x) or 0) + 0.5))
            local added_width = advance + (#current > 0 and glyph_gap or 0)
            if #current > 0 and current_width + added_width > inner_width then
                local line_ok, line_error = finish_line(false)
                if not line_ok then return nil, line_error end
                if #lines >= maximum_lines then break end
                added_width = advance
            end
            if not (codepoint == 32 and #current == 0) then
                current[#current + 1] = codepoint
                current_width = current_width + added_width
            end
        end
    end

    if #lines < maximum_lines and #current > 0 then
        local line_ok, line_error = finish_line(false)
        if not line_ok then return nil, line_error end
    end
    return lines, line_step
end

local function put_sign_mask_pixel(mask, touched_indices, canvas_width, canvas_height, x, y, alpha)
    if x < 0 or x >= canvas_width or y < 0 or y >= canvas_height or alpha <= 0 then return end
    local index = y * canvas_width + x
    local previous_alpha = mask[index]
    if alpha > (previous_alpha or 0) then
        if previous_alpha == nil then touched_indices[#touched_indices + 1] = index end
        mask[index] = alpha
    end
end

local function render_sign_surface(face, request)
    local ffi = M._ffi
    local freetype = M._freetype
    if not ffi or not freetype or face == nil then return nil, nil, "FreeType runtime is not initialized" end

    local transparent_background = rawget(request, "transparent_background") == true
    local background_color = rawget(request, "background_color")
    local base_data = nil
    if not transparent_background and type(background_color) ~= "table" then
        local base_error = nil
        base_data, base_error = read_binary_file(tostring(rawget(request, "base_texture_path") or ""))
        if not base_data then return nil, nil, tostring(base_error) end
    end
    local sign_width = normalize_canvas_dimension(rawget(request, "sign_width"))
    local sign_height = normalize_canvas_dimension(rawget(request, "sign_height"))
    local size_percent = math.max(20, math.min(300, math.floor((tonumber(rawget(request, "size_percent")) or 100) + 0.5)))
    local minimum_font_buffer_size = math.max(1, tonumber(rawget(request, "minimum_font_buffer_size")) or 1)
    local scaled_font_buffer_size = math.max(1, math.ceil(minimum_font_buffer_size * size_percent / 100))
    local canvas_width, canvas_height = calculate_canvas_dimensions(sign_width, sign_height, scaled_font_buffer_size)
    local canvas_scale = math.min(1, 8192 / canvas_width, 8192 / canvas_height, math.sqrt(4194304 / (canvas_width * canvas_height)))
    canvas_width = math.max(1, math.floor(canvas_width * canvas_scale))
    canvas_height = math.max(1, math.floor(canvas_height * canvas_scale))
    local canvas, canvas_error
    if transparent_background then
        canvas, canvas_error = allocate_transparent_canvas(canvas_width, canvas_height)
    elseif type(background_color) == "table" then
        canvas, canvas_error = allocate_solid_canvas(canvas_width, canvas_height, background_color)
    else
        canvas, canvas_error = allocate_sign_canvas(base_data, canvas_width, canvas_height)
    end
    if not canvas then return nil, nil, canvas_error end

    local codepoints = text_to_codepoints(tostring(rawget(request, "text") or ""))
    if #codepoints == 0 then return nil, nil, "empty text" end
    local render_side = math.max(1, math.min(canvas_width, canvas_height))
    local pixel_size = math.max(MIN_PIXEL_SIZE,
        math.floor(SIGN_RENDER_PIXEL_SIZE * size_percent * render_side / (100 * TEXT_DETAIL_REFERENCE_HEIGHT) + 0.5))
    local size_result = freetype.FT_Set_Pixel_Sizes(face, 0, pixel_size)
    if tonumber(size_result) ~= 0 then return nil, nil, "FT_Set_Pixel_Sizes=" .. tostring(size_result) end

    local logical_width = canvas_width
    local logical_height = canvas_height
    local padding_x = logical_width * SIGN_PADDING_RATIO
    local padding_y = logical_height * SIGN_PADDING_RATIO
    local inner_width = math.max(1, logical_width - padding_x * 2)
    local inner_height = math.max(1, logical_height - padding_y * 2)
    local glyph_cache = { glyphs = {}, remaining = 4 * 1024 * 1024 }
    local lines, line_step_or_error = build_sign_lines(freetype, face, codepoints, pixel_size, inner_width, inner_height, glyph_cache)
    if not lines then return nil, nil, tostring(line_step_or_error) end
    local line_step = line_step_or_error
    local block_height = #lines * line_step
    local block_top = padding_y + math.max(0, (inner_height - block_height) / 2)
    local mask = {}
    local touched_indices = {}
    local FT_LOAD_RENDER = 4

    for line_index, layout in ipairs(lines) do
        local shift_x = padding_x + (inner_width - layout.content_width) / 2 - layout.min_x
        local line_top = block_top + (line_index - 1) * line_step
        local shift_y = line_top + (line_step - layout.content_height) / 2 - layout.min_y
        for _, glyph in ipairs(layout.glyphs) do
            local metrics = glyph.metrics
            local bitmap = nil
            local bitmap_width = metrics.width
            local bitmap_rows = metrics.rows
            local bitmap_top = metrics.top
            if not metrics.bitmap_cached then
                local load_result = freetype.FT_Load_Char(face, glyph.codepoint, FT_LOAD_RENDER)
                if tonumber(load_result) ~= 0 then return nil, nil, "FT_Load_Char=" .. tostring(load_result) end
                local glyph_slot = face.glyph
                if glyph_slot == nil then return nil, nil, "glyph slot is nil during sign render" end
                bitmap = glyph_slot.bitmap
                bitmap_width = tonumber(bitmap.width) or 0
                bitmap_rows = tonumber(bitmap.rows) or 0
                bitmap_top = tonumber(glyph_slot.bitmap_top) or glyph.top
            end
            local origin_x = shift_x + glyph.draw_x
            local origin_y = shift_y - bitmap_top
            for source_y = 0, bitmap_rows - 1 do
                for source_x = 0, bitmap_width - 1 do
                    local alpha = metrics.bitmap_cached and tonumber(metrics.alpha[source_y * bitmap_width + source_x])
                        or get_bitmap_alpha(bitmap, source_x, source_y)
                    if alpha > 0 then
                        put_sign_mask_pixel(mask, touched_indices, canvas_width, canvas_height,
                            math.floor(origin_x + source_x + 0.5),
                            math.floor(origin_y + source_y + 0.5),
                            alpha)
                    end
                end
            end
        end
    end

    local color = rawget(request, "color") or {}
    local red = normalize_sign_channel(rawget(color, "red"))
    local green = normalize_sign_channel(rawget(color, "green"))
    local blue = normalize_sign_channel(rawget(color, "blue"))
    local text_opacity = transparent_background and 1 or normalize_sign_alpha(rawget(request, "text_alpha")) / 100
    for _, index in ipairs(touched_indices) do
        local alpha = math.floor(mask[index] * text_opacity + 0.5)
        if alpha > 0 then
            local offset = index * 4
            if transparent_background then
                canvas[offset + 0] = blue
                canvas[offset + 1] = green
                canvas[offset + 2] = red
                canvas[offset + 3] = alpha
            else
                canvas[offset + 0] = math.floor((canvas[offset + 0] * (255 - alpha) + blue * alpha) / 255 + 0.5)
                canvas[offset + 1] = math.floor((canvas[offset + 1] * (255 - alpha) + green * alpha) / 255 + 0.5)
                canvas[offset + 2] = math.floor((canvas[offset + 2] * (255 - alpha) + red * alpha) / 255 + 0.5)
                canvas[offset + 3] = 255
            end
        end
    end

    return canvas, {
        canvas_width = canvas_width,
        canvas_height = canvas_height,
        canvas_bytes_per_pixel = 4,
    }, nil
end

local function build_signature(slot_key, request, font_path)
    local transparent_background = rawget(request, "transparent_background") == true
    local parts = {
        tostring(slot_key),
        tostring(font_path),
        tostring(rawget(request, "size_percent") or 100),
        tostring(SIGN_CANVAS_PIXEL_SCALE),
        tostring(rawget(request, "text") or ""),
    }

    local color = rawget(request, "color") or {}
    parts[#parts + 1] = tostring(rawget(request, "sign_width") or SIGN_DEFAULT_SIZE)
    parts[#parts + 1] = tostring(rawget(request, "sign_height") or SIGN_DEFAULT_SIZE)
    parts[#parts + 1] = tostring(rawget(color, "red") or 0)
    parts[#parts + 1] = tostring(rawget(color, "green") or 0)
    parts[#parts + 1] = tostring(rawget(color, "blue") or 0)
    parts[#parts + 1] = transparent_background and "opaque" or tostring(normalize_sign_alpha(rawget(request, "text_alpha")))
    parts[#parts + 1] = tostring(rawget(request, "base_texture_path") or "")
    parts[#parts + 1] = tostring(rawget(request, "transparent_background") == true)
    local background_color = rawget(request, "background_color") or {}
    parts[#parts + 1] = tostring(rawget(background_color, "red") or "")
    parts[#parts + 1] = tostring(rawget(background_color, "green") or "")
    parts[#parts + 1] = tostring(rawget(background_color, "blue") or "")
    parts[#parts + 1] = tostring(SIGN_BACKGROUND_MAPPING_VERSION)

    return table.concat(parts, "|")
end

local function write_new_variant(slot_key, state, signature, request, font_path, now)
    local active_font_path = font_path
    local face_context, face_error = open_face(active_font_path)
    if not face_context then
        local fallback_font_path = get_resolved_default_ttf_path()
        if fallback_font_path and fallback_font_path ~= active_font_path then
            local fallback_context, fallback_error = open_face(fallback_font_path)
            if fallback_context then
                ttf_log("Face fallback activated: slot=%s from=%s to=%s error=%s",
                    tostring(slot_key), tostring(active_font_path), tostring(fallback_font_path), tostring(face_error))
                active_font_path = fallback_font_path
                face_context = fallback_context
                face_error = nil
            else
                face_error = tostring(face_error) .. " / fallback=" .. tostring(fallback_error)
            end
        end
    end
    if not face_context then
        ttf_log("Face open failed: slot=%s error=%s", tostring(slot_key), tostring(face_error))
        return false
    end

    local face = rawget(face_context, "face")
    if face == nil then
        close_face(face_context)
        ttf_log("Face open failed: slot=%s error=face is nil", tostring(slot_key))
        return false
    end

    local render_ok, canvas, meta, render_error = pcall(function()
        request.minimum_font_buffer_size = get_font_minimum_buffer_size(face, active_font_path)
        return render_sign_surface(face, request)
    end)
    close_face(face_context)
    if not render_ok then
        ttf_log("Render failed: slot=%s error=%s", tostring(slot_key), tostring(canvas))
        return false
    end
    if not canvas then
        ttf_log("Render failed: slot=%s error=%s", tostring(slot_key), tostring(render_error))
        return false
    end

    local ffi = M._ffi
    if not ffi then
        ttf_log("DDS build failed: slot=%s error=FFI unavailable", tostring(slot_key))
        return false
    end
    local canvas_width = tonumber(meta and rawget(meta, "canvas_width")) or 0
    local canvas_height = tonumber(meta and rawget(meta, "canvas_height")) or 0
    local dds_data, dds_error = build_bgra8_dds(ffi, canvas_width, canvas_height, canvas)
    if not dds_data then
        ttf_log("DDS build failed: slot=%s error=%s", tostring(slot_key), tostring(dds_error))
        return false
    end

    local variant = next_variant(state)
    local output_path = get_slot_file_path(slot_key, variant)
    local texture_name = get_slot_texture_name(slot_key, variant)
    local write_ok, write_error = write_binary_file(output_path, dds_data)
    if not write_ok then
        ttf_log("DDS write failed: slot=%s path=%s error=%s", tostring(slot_key), tostring(output_path), tostring(write_error))
        return false
    end

    state.pending = {
        signature = signature,
        texture_name = texture_name,
        ready_time = now + TEXTURE_READY_DELAY_MS,
        variant = variant,
    }
    state.request_signature = nil
    state.request_since = 0
    return true
end

function M.render_slot(slot_key, request)
    if not M.is_ready() then
        return nil, nil
    end

    local slot = SLOT_DEFS[slot_key]
    if type(slot) ~= "table" or type(request) ~= "table" then
        return nil, nil
    end
    local text_value = rawget(request, "text")
    if text_value == nil or text_value == "" then
        return nil, nil
    end

    if rawget(request, "font_family") ~= nil then
        local family, _, variant_index = M.find_font(rawget(request, "font_family"), rawget(request, "font_variant"))
        request.family = family
        request.variant_index = variant_index
    end

    local font_path = resolve_family_ttf_path(rawget(request, "family"), rawget(request, "variant_index"))
    if not font_path then
        return nil, nil
    end

    local state = get_slot_state(slot_key)
    local now = current_time_ms()
    local signature = build_signature(slot_key, request, font_path)
    discard_stale_pending(state, signature)

    if entry_signature(rawget(state, "active")) == signature then
        return active_result(state)
    end

    local pending = rawget(state, "pending")
    if entry_signature(pending) == signature then
        local ready_time = tonumber(rawget(pending, "ready_time")) or 0
        if now >= ready_time then return true, rawget(pending, "texture_name") end
        return false, nil
    end

    if rawget(state, "request_signature") ~= signature then
        state.request_signature = signature
        state.request_since = now
        return false, nil
    end

    if now - (tonumber(rawget(state, "request_since")) or now) < RENDER_DEBOUNCE_MS then
        return false, nil
    end

    if not write_new_variant(slot_key, state, signature, request, font_path, now) then
        state.request_signature = nil
        state.request_since = 0
        return nil, nil
    end
    return false, nil
end

function M.confirm_slot_texture(slot_key, texture_name)
    slot_key = tostring(slot_key or "")
    texture_name = tostring(texture_name or "")
    local state = M.slot_state[slot_key]
    if type(state) ~= "table" then return false end
    local active = rawget(state, "active")
    if type(active) == "table" and rawget(active, "texture_name") == texture_name then return true end
    local pending = rawget(state, "pending")
    if type(pending) ~= "table" or rawget(pending, "texture_name") ~= texture_name then return false end
    state.active = pending
    state.pending = nil
    return true
end
